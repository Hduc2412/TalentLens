# Backend origin used when USE_MOCK is disabled.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Mock is the default. Set to "false" to read from the FastAPI backend.
VITE_USE_MOCK=true

# Authentication
# PeopleLens verifies nothing client-side: RS256 tokens are issued by the
# identity provider and validated by the API. In mock mode the app mints a local
# unsigned token so the role picker works offline; with VITE_USE_MOCK=false the
# sign-in gate waits for a real access token instead.

# Mock mode signs itself in as HR_ADMIN so the demo opens straight on the board.
# Set to "false" to face the real sign-in page while still reading mock data —
# that is how the login, register and password-reset flows get exercised
# without an identity provider.
VITE_AUTO_SIGN_IN=true
