# Development keeps authentication configuration optional so /health can run
# before an auth environment is provisioned.
MOSA_ENVIRONMENT=development

# Required in production and when calling protected endpoints.
# Keep the PEM value in secret management; do not commit a real key here.
MOSA_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<public-key-body>\n-----END PUBLIC KEY-----"
# The mrag-user-be token contract uses client_id instead of iss/aud.
MOSA_JWT_ALLOWED_CLIENT_ID=2093
MOSA_JWT_LEEWAY_SECONDS=30

# Google Cloud project containing the PeopleLens Firestore database.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Usually keep the default Firestore database.
FIRESTORE_DATABASE=(default)
